root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

[*.ps1]
charset = utf-8-bom
indent_style = space
indent_size = 4

[*.psd1]
charset = utf-8-bom
indent_style = space
indent_size = 4

[*.cmd]
charset = latin1
indent_style = space
indent_size = 4

[*.{json,yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
