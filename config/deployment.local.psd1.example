@{
    # 配布管理者が実際の共有フォルダまたはGGUFファイルのUNCパスへ変更し、
    # deployment.local.psd1 という名前で保存してください。
    # フォルダを指定した場合、その直下にはモデル本体GGUFを1つだけ配置します。
    # 画像入力対応モデルでは、同じフォルダへ対応する mmproj-*.gguf を最大1つ追加できます。
    # mmprojは別モデルではなく、その1つのモデルに画像を渡すための付属ファイルです。
    ModelSourcePath = '\\SERVER\Share\Models'

    # ModelSourcePath にモデル本体ファイルを直接指定する場合だけ、必要に応じて
    # 次の行を有効にします。フォルダ指定時は自動検出されるため記載しません。
    # VisionProjectorPath = '\\SERVER\Share\Models\mmproj-F16.gguf'

    # LM Studio標準モデル領域に作る管理用リンクの配置名です。
    # 安全な復元範囲を限定するため、先頭の secure-deployment/ は変更しません。
    ModelUserRepo = 'secure-deployment/approved-model'

    # OFF: 既定。本プロジェクトの規則を使わず、会社側のFirewall/EDR等へ委任します。
    # ON : このプロジェクトがWindows Firewall規則を作成・監査します。
    # OFFは「通信を遮断済み」という意味ではありません。会社側の保護を別途確認してください。
    # OFFへ切り替えてSetupを再実行すると、本プロジェクトが以前作った規則だけを削除します。
    # Windows Firewall本体や会社側の規則をON/OFFする設定ではありません。
    ProjectFirewall = 'OFF'

    # 0-Install-and-Setup.cmdを使う場合の、配布済みLM Studioインストーラーです。
    # スクリプトはダウンロードせず、SHA-256、電子署名、製品バージョンを検証します。
    InstallerPath = '\\SERVER\Share\Packages\LM-Studio-x64.exe'
    InstallerSha256 = '<64-character-SHA-256>'
    InstallerProductVersion = '0.4.21+2'
    InstallerSignerThumbprint = '<40-character-certificate-thumbprint>'

    # OnlinePinned: 下記の完全指定Runtimeだけを公式CLIで自動取得・選択します。
    # Existing    : ダウンロードせず、事前導入済みの完全一致Runtimeを要求します。
    RuntimeProvisioning = 'OnlinePinned'
    RequiredRuntime = 'llama.cpp-win-x86_64-nvidia-cuda12-avx2@2.28.2'
}
